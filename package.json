    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.4.2"
  }
